# Build output -- large and fully reproducible from source.
dist/
build/
*.spec

# PyInstaller writes the .spec next to the project; build.py regenerates it.
# It hardcodes absolute paths from the machine that built it, so it must not be
# shared: another checkout would package the original author's folders.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# Local data and scratch space
mydata/
scratch/
.freebuff/

# '~' is a stray copy of the user's home directory that landed in the project
# root. It holds 180k+ files including shell history and auth tokens, so it must
# never be committed. Ignored rather than deleted: it belongs to the user, not
# to this repository.
~/

# Generated artwork. The one committed input is assets/pryonx-logo-source.jpg;
# everything else is derived from it by tools/make_brand_assets.py, which
# build.py and the app both run automatically.
assets/*.png
assets/*.ico
assets/brand-preview.html

# Installer output (also covered by dist/)
*.exe

# Signing keys must never enter the repository, wherever they happen to live.
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
Keys/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
# Generated by build.py on every run; never committed.
assets/version_info.txt

# Locally extracted CI download artifacts (large binaries) - never commit.
release/
